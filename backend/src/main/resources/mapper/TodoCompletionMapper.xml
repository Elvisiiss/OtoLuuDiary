<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.otoluudiary.mapper.TodoCompletionMapper">

    <resultMap id="completionMap" type="com.otoluudiary.model.TodoCompletion">
        <id property="id" column="id"/>
        <result property="todoId" column="todo_id"/>
        <result property="note" column="note"/>
        <result property="createdAt" column="created_at"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <select id="findByTodoId" resultMap="completionMap">
        SELECT * FROM todo_completion WHERE todo_id = #{todoId} AND is_deleted = 0 ORDER BY created_at DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO todo_completion (todo_id, note, created_at)
        VALUES (#{todoId}, #{note}, #{createdAt})
    </insert>

    <!-- 假删除：标记 is_deleted=1 -->
    <update id="deleteById">
        UPDATE todo_completion SET is_deleted = 1, deleted_at = #{deletedAt}
        WHERE id = #{id} AND is_deleted = 0
    </update>
</mapper>
