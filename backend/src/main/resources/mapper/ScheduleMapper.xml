<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.otoluudiary.mapper.ScheduleMapper">

    <resultMap id="scheduleMap" type="com.otoluudiary.model.Schedule">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="name" column="name"/>
        <result property="dayOfWeek" column="day_of_week"/>
        <result property="timeSlot" column="time_slot"/>
        <result property="location" column="location"/>
        <result property="createdAt" column="created_at"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <select id="findByUserId" resultMap="scheduleMap">
        SELECT * FROM schedule WHERE user_id = #{userId} AND is_deleted = 0 ORDER BY time_slot ASC, day_of_week ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO schedule (user_id, name, day_of_week, time_slot, location, created_at)
        VALUES (#{userId}, #{name}, #{dayOfWeek}, #{timeSlot}, #{location}, #{createdAt})
    </insert>

    <!-- 假删除：标记 is_deleted=1 -->
    <update id="deleteById">
        UPDATE schedule SET is_deleted = 1, deleted_at = #{deletedAt}
        WHERE id = #{id} AND is_deleted = 0
    </update>
</mapper>
