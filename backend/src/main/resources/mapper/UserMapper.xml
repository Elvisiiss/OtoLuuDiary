<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.otoluudiary.mapper.UserMapper">

    <resultMap id="userResultMap" type="com.otoluudiary.model.User">
        <id     property="id"        column="id"/>
        <result property="phone"     column="phone"/>
        <result property="password"  column="password"/>
        <result property="nickname"  column="nickname"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="userColumns">
        id, phone, password, nickname, created_at
    </sql>

    <insert id="insert">
        INSERT INTO `user` (id, phone, password, nickname, created_at)
        VALUES (#{id}, #{phone}, #{password}, #{nickname}, #{createdAt})
    </insert>

    <select id="findByPhone" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM `user`
        WHERE phone = #{phone}
    </select>

    <select id="findById" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM `user`
        WHERE id = #{id}
    </select>

</mapper>
